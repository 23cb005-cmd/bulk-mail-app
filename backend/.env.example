# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/bulk_mail_app

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# Admin seed credentials (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# SMTP / Nodemailer
# Example for Gmail: use an App Password, not your normal password.
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Bulk Mailer
SMTP_FROM_EMAIL=your_email@gmail.com

# Frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
